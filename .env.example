# .env.example → .env 로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다(.gitignore에 있음).
# Supabase → 프로젝트 → Connect → ORMs → Prisma 에 나오는 두 줄을 그대로 붙여 넣으면 된다.

# 풀러(Transaction) 6543 — 앱이 쓰는 주소. Vercel 환경 변수에는 이것만 넣는다.
DATABASE_URL="postgresql://postgres.<프로젝트ref>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 직접(Session) 5432 — npm run db:push 때만 쓴다.
DIRECT_URL="postgresql://postgres.<프로젝트ref>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres"
